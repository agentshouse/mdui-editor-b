{
  "name": "house-editor-b",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node scripts/prepare-release.mjs && vite build",
    "release:check": "node scripts/check-release.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "starter:check": "node scripts/check-starter.mjs",
    "publish": "node publish.mjs",
    "verify": "npm run test:publisher && npm run typecheck && npm run lint && npm test -- --maxWorkers=1 && npm run starter:check && npm run model:check && npm run build && npm run release:check",
    "model:check": "node scripts/validate-model.mjs",
    "test:publisher": "node --test scripts/publish-regression.mjs"
  },
  "dependencies": {
    "@agentshouse/app-bridge": "0.1.0-ce524f6608238",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "platejs": "53.3.15",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/list-classic": "53.0.0",
    "@platejs/code-block": "53.0.0",
    "@platejs/link": "53.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "lucide-react": "0.514.0",
    "@radix-ui/react-toolbar": "1.1.10",
    "@radix-ui/react-tooltip": "1.2.7",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-slot": "1.2.3"
  },
  "devDependencies": {
    "@agentshouse/mdmodel": "0.1.0-c68e2039f1ca8",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
